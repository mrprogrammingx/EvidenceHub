# Copy to .env and adjust. Never commit the real .env (gitleaks + .gitignore enforce this).

EVIDENCEHUB_ENV=local
LOG_LEVEL=INFO

# --- MySQL: catalog / shard-map instance ---
MYSQL_CATALOG_HOST=127.0.0.1
MYSQL_CATALOG_PORT=3306
MYSQL_CATALOG_DB=evidencehub_catalog
MYSQL_CATALOG_USER=evidencehub
MYSQL_CATALOG_PASSWORD=change_me_dev_password

# --- MySQL: 4 physical shards (comma-separated host:port, index 0..3) ---
MYSQL_SHARD_HOSTS=127.0.0.1:3307,127.0.0.1:3308,127.0.0.1:3309,127.0.0.1:3310
MYSQL_SHARD_DB_PREFIX=evidencehub_shard
MYSQL_SHARD_USER=evidencehub
MYSQL_SHARD_PASSWORD=change_me_dev_password

# Root password used only by the compose containers themselves (init/admin), never by the app
MYSQL_ROOT_PASSWORD=change_me_root_password

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Seed generator (two-tier: fast dev default vs full perf-report scale) ---
SEED_ROWS_DEFAULT=1000000
SEED_ROWS_FULL=20000000
SEED_BATCH_SIZE=2000

# --- API (added in P5) ---
API_HOST=0.0.0.0
API_PORT=8000
